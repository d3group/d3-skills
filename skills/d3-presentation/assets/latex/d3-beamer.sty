% ============================================================================
% AGENDA SLIDE - INTERNAL HELPERS
% ============================================================================
\newcounter{agendacounter}

\newcommand{\d@drawsectionitemlinked}[6]{%
  \pgfmathsetmacro{\startoffset}{0.5 - (#6-1)*0.045}
  \node[circle, fill=#4, text=white, font=\bfseries\normalsize, minimum size=1.8em, inner sep=0pt]
    at ([xshift=0.14\paperwidth, yshift={-\startoffset*\paperheight - #1*0.09\paperheight}]current page.north west)
    {\hyperlink{d3sec-#2}{#2}};
  \node[anchor=west, font=\bfseries\normalsize, text=#5]
    at ([xshift=0.18\paperwidth, yshift={-\startoffset*\paperheight - #1*0.09\paperheight}]current page.north west)
    {\hyperlink{d3sec-#2}{#3}};
}

