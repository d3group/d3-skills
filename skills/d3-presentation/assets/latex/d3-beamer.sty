        at ([xshift=0.19\paperwidth, yshift=-0.09\paperheight]current page.north west) {%
          \color{d3-navy}\Large\bfseries\linespread{1.15}\selectfont #1};
      \node[anchor=north west, inner sep=0pt, text width=0.427\paperwidth, align=left]
        at ([xshift=0.057\paperwidth, yshift=-0.24\paperheight]current page.north west) {%
          \color{d3-navy}\small%
          \begin{minipage}[t][0.38\paperheight][t]{0.427\paperwidth}#2\end{minipage}};
      \node[anchor=north west, inner sep=0pt, text width=0.427\paperwidth, align=left]
        at ([xshift=0.51\paperwidth, yshift=-0.24\paperheight]current page.north west) {%
          \color{d3-navy}\small%
          \begin{minipage}[t][0.38\paperheight][t]{0.427\paperwidth}#3\end{minipage}};
      \node[anchor=north west, inner sep=0pt, text width=0.87\paperwidth, align=left]
        at ([xshift=0.057\paperwidth, yshift={-0.66\paperheight-\d@takeawayshift}]current page.north west) {%
          \color{d3-navy}\small%
          \begin{tcolorbox}[colback=d3-orange!5,colframe=d3-orange,boxrule=0pt,leftrule=3pt,arc=0pt,left=6pt,right=6pt,top=4pt,bottom=4pt]
