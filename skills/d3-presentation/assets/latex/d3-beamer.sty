% ============================================================================
% TITLE SLIDE
% ============================================================================
\newcommand{\titleslide}{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=south west, inner sep=0pt] at (current page.south west) {%
        \includegraphics[width=\paperwidth, height=\paperheight]{assets/Title_template.pdf}};
      \node[anchor=north west, inner sep=0pt, text width=0.73\paperwidth, align=left]
        at ([xshift=0.135\paperwidth, yshift=-0.33\paperheight]current page.north west) {%
          \color{d3-navy}\LARGE\bfseries\inserttitle};
      \node[anchor=north west, inner sep=0pt, text width=0.73\paperwidth, align=left]
        at ([xshift=0.135\paperwidth, yshift=-0.50\paperheight]current page.north west) {%
          \color{d3-navy}\large\insertsubtitle};
    \end{tikzpicture}
  \end{frame}\d@uncount
}

% ============================================================================
% CONTENT SLIDE - ONE COLUMN
% ============================================================================
\newcommand{\onecol}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=south west, inner sep=0pt] at (current page.south west) {%
        \includegraphics[width=\paperwidth, height=\paperheight]{assets/Slide_template.pdf}};
      \node[anchor=north west, inner sep=0pt, text width=0.72\paperwidth, align=left]
        at ([xshift=0.19\paperwidth, yshift=-0.09\paperheight]current page.north west) {%
          \color{d3-navy}\Large\bfseries\linespread{1.15}\selectfont #1};
      \node[anchor=north west, inner sep=0pt, text width=0.885\paperwidth, align=left]
        at ([xshift=0.057\paperwidth, yshift=-0.24\paperheight]current page.north west) {%
          \color{d3-navy}\small%
          \begin{minipage}[t][0.60\paperheight][t]{0.885\paperwidth}#2\end{minipage}};
      \node[anchor=south west, inner sep=0pt]
        at ([xshift=0.057\paperwidth, yshift=0.038\paperheight]current page.south west) {%
          \color{white}\tiny\d@framelabel};
      \node[anchor=south west, inner sep=0pt]
        at ([xshift=0.115\paperwidth, yshift=0.034\paperheight]current page.south west) {%
          \color{black}\tiny \d@chair~|~\d@name};
    \end{tikzpicture}
  \end{frame}
}

