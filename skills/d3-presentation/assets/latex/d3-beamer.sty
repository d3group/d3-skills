% D3 (Data Driven Decisions) Beamer Style
% Uses PDF backgrounds with fixed-position content boxes
% Version 4.0 - Modular structure with separate template library
% REQUIRES: XeLaTeX (for Inter font)

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{d3-beamer}[2026/02/01 D3 Beamer Theme with PDF Backgrounds]

% ============================================================================
% OPTIONS
% ============================================================================
% contentnumbering: title, agenda, section-divider and thank-you frames do not
% advance the frame counter, so the footer counts content slides only. Loads
% appendixnumberbeamer, so \appendix after \thankyouslide restarts the numbering
% for backup slides and makes the total the last content slide.
\newif\ifd@contentnumbering
\DeclareOption{contentnumbering}{\d@contentnumberingtrue}
\ProcessOptions\relax

% ============================================================================
% REQUIRED PACKAGES
% ============================================================================
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{fontspec}         % Modern font handling (requires XeLaTeX)
\RequirePackage{xcolor}
\RequirePackage{etoolbox}         % For list handling
\hypersetup{hidelinks}            % For clickable navigation without colored boxes
\RequirePackage{tcolorbox}        % For code boxes and highlighted boxes
\ifd@contentnumbering\RequirePackage{appendixnumberbeamer}\fi
\newcommand{\d@uncount}{\ifd@contentnumbering\addtocounter{framenumber}{-1}\fi}
% hide the page number on single frames (e.g. a speaker slide after the thank-you slide):
% \hidenumber before the frame, \shownumber after it; combine with \d@uncount to keep the total.
\newif\ifd@nonumber
\newcommand{\hidenumber}{\d@nonumbertrue}
\newcommand{\shownumber}{\d@nonumberfalse}
\newcommand{\d@framelabel}{\ifd@nonumber\else\insertframenumber/\inserttotalframenumber\fi}
\newcommand{\d@structnumber}{\ifd@contentnumbering\else\insertframenumber/\inserttotalframenumber\fi}

% TikZ libraries for diagrams
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, shapes.arrows, decorations.pathreplacing}

% ============================================================================
% FONT SETUP - Inter (bundled in assets/fonts/)
% ============================================================================
% Using bundled Inter 18pt fonts for consistent rendering across systems
\setsansfont{Inter}[
    Path = assets/fonts/,
    Extension = .ttf,
    UprightFont = Inter_18pt-Regular,
    BoldFont = Inter_18pt-Bold,
    ItalicFont = Inter_18pt-Italic,
    BoldItalicFont = Inter_18pt-BoldItalic
]

% ============================================================================
% D3 BRAND COLORS
% ============================================================================
\definecolor{d3-navy}{RGB}{21,63,135}    % University blue - primary
\definecolor{d3-orange}{HTML}{f29100}    % Orange - accent/highlight
\definecolor{d3-gray}{RGB}{128,128,128}  % Gray - subtle text, borders
\definecolor{d3-lightblue}{RGB}{200,220,240}  % Light blue - chart fills
\definecolor{d3-darkblue}{RGB}{10,40,100}     % Dark blue - darker variant

% ============================================================================
% BEAMER SETUP
% ============================================================================
\mode<presentation>

% Remove all default beamer elements
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{frametitle}{}
\setbeamertemplate{itemize items}[square]
\setbeamercolor{itemize item}{fg=d3-navy}
\setbeamercolor{itemize subitem}{fg=d3-navy}
\setbeamercolor{itemize subsubitem}{fg=d3-navy}
\setbeamercolor{enumerate item}{fg=d3-navy}
\setbeamercolor{enumerate subitem}{fg=d3-navy}

% Text colors
\setbeamercolor{normal text}{fg=d3-navy}
\setbeamercolor{structure}{fg=d3-navy}

% Set geometry to use full slide area
\setbeamersize{text margin left=0pt, text margin right=0pt}

