% d3-poster.sty
% D3-branded reskin for the baposter class in the 2025 corporate design of the
% University of Wuerzburg (A0 template "Wissenschaftliches Poster").
%
%   * Palette: university navy #02246C (d3-navy); D3 orange #F29100 stays the
%     accent; baposter's uniblue is remapped to d3-navy.
%   * Font: Inclusive Sans UW via fontspec (XeLaTeX/LuaLaTeX); Helvetica clone
%     under pdfLaTeX. Greek letters and math symbols the font lacks are mapped
%     to math mode with newunicodechar.
%   * University frame, drawn by a thin wrapper around baposter's poster
%     environment: navy header box with the white university logo, white
%     title and authors, blue seal flush with the box's bottom-right corner;
%     grey (#ECECEC) section bars with navy SemiBold text (box key `emphasis`
%     gives the cornflower bar with white text); footer with a navy rule, a
%     logo row (D3 logo first) and a references slot.
%   * \highlight / \keypoint / infobox / card macros shared with d3-abstract.
%
% Usage:
%   \documentclass[a0paper]{baposter}
%   \usepackage{assets/d3-poster}
%   \begin{poster}{options}{}{Title}{Authors}{\dthreelogos}
%     ...                       % the 5th argument fills the footer logo row
%     \dthreereferences{...}    % optional: footer references slot
%   \end{poster}
%
% Geometry is given in "template millimetres": 1\dthreeunit = 1 mm on A0
% portrait; it scales with the shorter paper side for A1 and other sizes.
%
% The seal is an interim choice: the CD booklet replaces it with a faculty
% ornament in faculty and chair communication once that package is released.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{d3-poster}[2026/10/13 D3 Poster Reskin for baposter (UWue CD 2025)]

\@ifclassloaded{baposter}{}{%
  \PackageError{d3-poster}{d3-poster.sty needs the baposter class}%
    {Use \string\documentclass[a0paper]{baposter} with baposter.cls next to the .tex file.}}

\RequirePackage{iftex}
\RequirePackage{graphicx}
\RequirePackage{amssymb}        % \blacksquare (bullets), \checkmark
\RequirePackage{newunicodechar}

% ====================
% Palette (2025 corporate design; names shared by all D3 skills)
% ====================
\definecolor{d3-navy}{HTML}{02246C}       % titles, structure, header box, rules
\definecolor{d3-darkblue}{HTML}{011646}   % deepest surfaces
\definecolor{d3-orange}{HTML}{F29100}     % D3 accent: \highlight, alert card
\definecolor{d3-orange-ink}{HTML}{B86E00} % orange as small text on white
\definecolor{d3-gray}{HTML}{808080}       % secondary marks, placeholders
\definecolor{d3-lightblue}{HTML}{CBD9EE}  % card and infobox fills
\definecolor{d3-blue}{HTML}{5E8AC7}       % cornflower: bullets, emphasis bar
\definecolor{d3-sky}{HTML}{5AA1D8}        % large numerals
\definecolor{d3-sand}{HTML}{F1EBDF}       % quiet boxes, takeaway background
\definecolor{d3-teal}{HTML}{009485}       % chart series
\definecolor{d3-teal-ink}{HTML}{007A6E}   % teal as text
\definecolor{d3-yellow}{HTML}{F8C300}     % chart series
\definecolor{d3-berry}{HTML}{821044}      % chart series
\definecolor{d3-peach}{HTML}{FCE4BF}      % light orange fill
\definecolor{d3-lavender}{HTML}{D9CCE6}   % light fill
\definecolor{d3-hairline}{HTML}{D3D6DC}   % thin rules on white
\definecolor{d3-headergray}{HTML}{ECECEC} % section heading bars

% baposter.cls defines uniblue; older posters use it for borders and bars.
\definecolor{uniblue}{HTML}{02246C}
\AtBeginDocument{\definecolor{uniblue}{HTML}{02246C}}

% ====================
% Fonts
% Inclusive Sans UW has Regular, Italic, Medium, SemiBold and Bold. There is
% no Bold Italic; it is faked with a slant. \titlefont = SemiBold (section
% bars, subheadings, footer heading), \mediumfont = Medium.
% The font has no tabular figures; do not request Numbers=Monospaced.
% ====================
\newif\ifdthree@fontspec
\ifxetex \dthree@fontspectrue \fi
\ifluatex \dthree@fontspectrue \fi

\ifdthree@fontspec
  \RequirePackage{fontspec}
  \setsansfont{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    Ligatures = TeX,
    UprightFont = *-Regular,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
  ]
  \setmainfont{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    Ligatures = TeX,
    UprightFont = *-Regular,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
  ]
  \newfontfamily{\titlefont}{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    Ligatures = TeX,
    UprightFont = *-SemiBold,
    BoldFont = *-Bold,
    ItalicFont = *-SemiBold,
    ItalicFeatures = {FakeSlant=0.2},
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
  ]
  \newfontfamily{\mediumfont}{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    Ligatures = TeX,
    UprightFont = *-Medium,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
  ]
  \renewcommand{\familydefault}{\sfdefault}
\else
  % pdfLaTeX fallback: Helvetica clone, bold for SemiBold.
  \RequirePackage[scaled]{helvet}
  \renewcommand{\familydefault}{\sfdefault}
  \newcommand{\titlefont}{\sffamily\bfseries}
  \newcommand{\mediumfont}{\sffamily}
\fi

