% ====================
% Layout
% ====================
\columnsep=20pt
\graphicspath{{./figures/}{./assets/logos/}{./logos/}}
\newcommand{\figbredde}{1.0\linewidth}

% Header geometry, after the university letterhead
\newlength{\dabs@unilogowidth}\setlength{\dabs@unilogowidth}{46mm}  % university logo, top left
\newlength{\dabs@dlogowidth}\setlength{\dabs@dlogowidth}{38mm}      % D3 logo, top right

% ====================
% Slot Variables (defaults)
% ====================
\newcommand{\undertittel}{}
\newcommand{\innledning}{}
\newcommand{\helbredde}{}     % Optional full-width block between lead paragraph and columns
\newcommand{\bildebredde}{1.0\linewidth}
\newcommand{\venstre}{}
\newcommand{\hoyre}{}
\newcommand{\projektname}{}   % If set, replaces the group and chair line in the footer
\newcommand{\abstractpages}{1} % Declared page count; values above 1 add "page / total" to the footer

% ====================
% Empty-slot test
% \dabs@ifempty{<text or slot macro>}{<if empty>}{<if filled>}
% Expands the argument once, so a slot macro is judged by its content.
% ====================
\newcommand{\dabs@ifempty}[1]{%
\expandafter\def\expandafter\dabs@tmp\expandafter{#1}%
\ifx\dabs@tmp\@empty
  \expandafter\@firstoftwo
\else
  \expandafter\@secondoftwo
\fi}

% ====================
% Header Macro
% \setheader{title}{subtitle}
% Logo row (university logo left, D3 logo right, vertically centred),
% hairline, title (navy SemiBold), subtitle.
% With an empty subtitle only the title line renders.
% ====================
\newcommand{\setheader}[2]{%
\par\noindent
\begin{minipage}{\linewidth}
\parskip=0pt
\noindent
\begin{minipage}[c]{\dabs@unilogowidth}
\includegraphics[width=\linewidth]{uw-logo-navy.pdf}
\end{minipage}%
\hfill
\begin{minipage}[c]{\dabs@dlogowidth}
\raggedleft
\includegraphics[width=\linewidth]{logo-d3.pdf}
\end{minipage}\par
\vspace{2.5mm}%
{\color{d3-hairline}\rule{\linewidth}{0.5pt}}\par
\vspace{3mm}%
{\raggedright\color{d3-navy}\LARGE\titlefont #1\par}%
\dabs@ifempty{#2}{}{\vspace{0.4em}{\raggedright\color{black}\normalsize\titlefont\itshape #2\par}}%
\end{minipage}\par
\vspace{1.5ex}}

% ====================
% Section Heading
% \sectionhead{text}
% ====================
\newcommand{\sectionhead}[1]{%
\vspace{2ex}\noindent
{\titlefont \large \color{d3-navy} #1}%
\par\vspace{0.8ex}%
}

% ====================
% Ingress (full-width lead text)
% \ingress{text}
% ====================
\newcommand{\ingress}[1]{%
{\large \sffamily #1\par}%
}

% Lead paragraph block, called by the template.
% Skipped when \innledning is empty (continuation pages).
\newcommand{\ingressblock}{%
\dabs@ifempty{\innledning}{}{%
\begin{minipage}{1.0\linewidth}
{\color{d3-navy}\ingress{\innledning}}
\end{minipage}
\par\vspace{3ex}}}

% Full-width block, called by the template.
% Skipped when \helbredde is empty.
\newcommand{\fullwidthblock}{%
\dabs@ifempty{\helbredde}{}{%
\vspace{-1.5ex}%
\begin{minipage}{1.0\linewidth}
\small \helbredde\par
\end{minipage}
\par\vspace{1ex}}}

% ====================
% Figure Macros
% ====================

% Standard column-width figure
\newcommand{\figur}[2]{%
\begin{minipage}{1.01\linewidth}
\begin{flushleft}
\includegraphics[width=\figbredde]{#1}
\end{flushleft}
\vspace{-1ex}
{\textbf{\color{black} \footnotesize \begin{spacing}{0.7} #2 \end{spacing}}}
\end{minipage}}

% Large figure (alias of \figur, for semantic clarity)
\newcommand{\storfigur}{\figur}

% Centered image with configurable width
\newcommand{\bilde}[2]{%
\begin{minipage}{0.99\linewidth}
\begin{center}
\includegraphics[width=\bildebredde]{#1}
\end{center}
{\textbf{\color{black} \footnotesize \begin{spacing}{0.7} #2 \end{spacing}}}
\end{minipage}}

% Full-width figure for the \helbredde slot (75% of the text width, centered)
\newcommand{\helfigur}[2]{%
\begin{center}
\begin{minipage}{0.75\linewidth}
\includegraphics[width=\linewidth]{#1}
\par\vspace{0.5ex}
{\textbf{\color{black} \footnotesize #2}\par}
\end{minipage}
\end{center}}

% ====================
% Highlight Macros
% ====================

% Inline highlight (d3-orange bold)
\newcommand{\highlight}[1]{%
{\color{d3-orange}\textbf{#1}}%
}

% Callout box (d3-navy), takeaway text in Medium
\newcommand{\keypoint}[1]{%
\begin{tikzpicture}
\node[fill=d3-navy!8, inner sep=10pt, text width=\linewidth-22pt] (kp) {%
{\color{d3-navy}\mediumfont #1}%
};
\draw[d3-navy, line width=3pt] (kp.north west) -- (kp.south west);
\end{tikzpicture}%
}

% ====================
% Reference List
% \begin{reflist} \item ... \end{reflist}
% Compact numbered references; cite in the text as [1], [2].
% ====================
\newenvironment{reflist}
{\begingroup\footnotesize
 \begin{enumerate}[label={[\arabic*]}, leftmargin=2.2em, nosep, itemsep=1pt]}
{\end{enumerate}\endgroup}

% ====================
% TikZ Card Styles
% ====================
\tikzset{
    card/.style={fill=d3-lightblue, inner sep=8pt},
    card gray/.style={fill=black!3, inner sep=8pt},
    card highlight/.style={fill=d3-navy!8, inner sep=10pt},
    card alert/.style={
        fill=d3-orange!8,
        inner sep=8pt,
        append after command={
            (\tikzlastnode.north west) edge[line width=3pt, d3-orange] (\tikzlastnode.south west)
        }
    },
    infobox/.style={
        fill=d3-lightblue,
        minimum height=0.8cm,
        text width=\linewidth-14pt,
        align=center,
        inner sep=6pt,
        append after command={
            (\tikzlastnode.north west) edge[line width=3pt, d3-navy] (\tikzlastnode.south west)
        }
    },
    tag/.style={fill=d3-navy!8, inner sep=3pt, font=\small},
}

% ====================
% Footer Macro
% Hairline, then the group and chair line in gray (left) and "page / total" (right).
% \projektname, when set, replaces the group and chair line.
% "page / total" appears when \abstractpages is above 1, as in the letterhead.
% The chair line follows the document language (German for ngerman or german).
% ====================
\newcommand{\dabs@ifgerman}[2]{%
\@ifundefined{languagename}{#2}{%
\edef\dabs@lang{\detokenize\expandafter{\languagename}}%
\edef\dabs@de{\detokenize{ngerman}}%
\edef\dabs@deold{\detokenize{german}}%
\ifx\dabs@lang\dabs@de #1\else\ifx\dabs@lang\dabs@deold #1\else #2\fi\fi}}

\newcommand{\dabs@chairline}{%
\dabs@ifgerman
{Data Driven Decisions Group\enspace|\enspace Lehrstuhl f\"ur Wirtschaftsinformatik und Business Analytics\enspace|\enspace Universit\"at W\"urzburg}%
{Data Driven Decisions Group\enspace|\enspace Chair of Information Systems and Business Analytics\enspace|\enspace University of W\"urzburg}}

\newcommand{\bunntekst}{%
\vfill
\null
\par\noindent{\color{d3-hairline}\rule{\textwidth}{0.5pt}}\par
\vspace{-0.6ex}%
\noindent{\footnotesize\color{d3-gray}%
\dabs@ifempty{\projektname}{\dabs@chairline}{\projektname}%
\ifnum\abstractpages>1 \hfill\thepage\,/\,\abstractpages\fi\par}}

% ====================
% Reset Slot Variables (per-page slots only)
% ====================
\newcommand{\resetslots}{%
\renewcommand{\undertittel}{}%
\renewcommand{\innledning}{}%
\renewcommand{\helbredde}{}%
\renewcommand{\bildebredde}{1.0\linewidth}%
\renewcommand{\venstre}{}%
\renewcommand{\hoyre}{}%
}

