% d3-abstract.sty
% D3-branded abstract style (A4, two columns, one or more pages)
% Adapted from the SKDE faktaark template with D3 visual identity,
% framed by the 2025 corporate design of the University of Würzburg (letterhead)
% Requires XeLaTeX or LuaLaTeX

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{d3-abstract}[2026/10/13 D3 Abstract Style, University of Wuerzburg CD 2025]

% ====================
% Required Packages
% ====================
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{multicol}
\RequirePackage{setspace}
\RequirePackage{tikz}
\usetikzlibrary{shapes,positioning,calc}
\RequirePackage{amssymb}         % \checkmark for the text-mode ✓ mapping
\RequirePackage{newunicodechar}  % Greek and symbols that the text font lacks
\RequirePackage[colorlinks, citecolor=black, linkcolor=black, urlcolor=d3-navy]{hyperref}
\RequirePackage{booktabs}    % Professional tables (\toprule, \midrule, \bottomrule)
\RequirePackage{siunitx}     % Decimal-aligned numeric columns (S column type)
% Numbers in the text font (Inclusive Sans UW). The font has proportional figures
% only (no tnum feature); S columns align on the decimal marker.
\sisetup{mode=text}
% siunitx reserves the width of an "8" per digit; a "0" or "4" in this font is up to
% 0.024 em wider. Tolerate that sub-point overhang inside tables, so the log reports
% only real overflows.
\AddToHook{env/tabular/begin}{\hfuzz=1.5pt\relax}
\AddToHook{env/tabular*/begin}{\hfuzz=1.5pt\relax}
\RequirePackage{enumitem}    % List customization

% ====================
% D3 Color Palette (University of Würzburg corporate design 2025)
% d3-navy, d3-darkblue, d3-orange, d3-gray, d3-lightblue keep their names.
% ====================
\definecolor{d3-navy}{HTML}{02246C}       % titles, headings, links, accent rules
\definecolor{d3-darkblue}{HTML}{011646}   % deepest surfaces
\definecolor{d3-orange}{HTML}{F29100}     % D3 accent: highlights, alerts
\definecolor{d3-orange-ink}{HTML}{B86E00} % orange as small text on white
\definecolor{d3-gray}{HTML}{808080}       % footer text, comparison methods
\definecolor{d3-lightblue}{HTML}{CBD9EE}  % card and infobox fills
\definecolor{d3-blue}{HTML}{5E8AC7}       % cornflower: bullets, secondary series
\definecolor{d3-sky}{HTML}{5AA1D8}        % large numerals
\definecolor{d3-sand}{HTML}{F1EBDF}       % quiet boxes
\definecolor{d3-teal}{HTML}{009485}       % chart series
\definecolor{d3-teal-ink}{HTML}{007A6E}   % teal as text
\definecolor{d3-yellow}{HTML}{F8C300}     % chart series
\definecolor{d3-berry}{HTML}{821044}      % chart series
\definecolor{d3-peach}{HTML}{FCE4BF}      % light orange fill
\definecolor{d3-lavender}{HTML}{D9CCE6}   % light fill
\definecolor{d3-hairline}{HTML}{D3D6DC}   % rule under the logo row and above the footer

% Lists: tight, bullets in cornflower blue
% (a drawn dot: the font's own bullet is small)
\setlist[itemize]{nosep, leftmargin=1.2em, label={\tikz[baseline=-0.55ex]\fill[d3-blue] (0,0) circle (0.17em);}}
\setlist[enumerate]{nosep, leftmargin=1.5em}

% ====================
% Font Setup (Inclusive Sans UW via fontspec)
% The family has no Bold Italic: bold italic is the Bold face, slanted.
% ====================
\RequirePackage{fontspec}
\setmainfont{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    UprightFont = *-Regular,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
]
\setsansfont{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    UprightFont = *-Regular,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
]
% Title and headings: SemiBold
\newfontfamily{\titlefont}{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    UprightFont = *-SemiBold,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
]
% Medium: takeaway text in \keypoint
\newfontfamily{\mediumfont}{InclusiveSansUW}[
    Path = assets/fonts/,
    Extension = .ttf,
    UprightFont = *-Medium,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-Bold,
    BoldItalicFeatures = {FakeSlant=0.2}
]

